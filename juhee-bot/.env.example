JUHEE_URL=http://juhee.kevin-dev.kro.kr

# Discord Bot Configuration
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Azure Cognitive Services (TTS)
SPEECH_KEY=your_azure_cognitive_services_key_here
SPEECH_REGION=your_azure_region_here
LANGUAGE_KEY=your_azure_language_service_key_here
LANGUAGE_ENDPOINT=your_azure_language_service_endpoint_here

# Korean Discord List (Optional)
# Koreanbots 봇 토큰 (https://koreanbots.dev/bots/{봇ID}/stats 에서 확인)
KOREANBOTS_TOKEN=your_koreanbots_bot_token_here

# Server Configuration
PORT=3000

# 기타 설정
DEV_MODE=false
DEV_SERVER_ID=your_dev_server_id_here
SUPERTONIC_TOTAL_STEP=4