JUHEE_URL=http://juhee.kevin-dev.kro.kr

# Discord Bot Configuration
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Azure Cognitive Services (TTS)
SPEECH_KEY=your_azure_cognitive_services_key_here
SPEECH_REGION=your_azure_region_here
LANGUAGE_KEY=your_azure_language_service_key_here
LANGUAGE_ENDPOINT=your_azure_language_service_endpoint_here

# Korean Discord List (Optional)
# Koreanbots 봇 토큰 (https://koreanbots.dev/bots/{봇ID}/stats 에서 확인)
KOREANBOTS_TOKEN=your_koreanbots_bot_token_here

# Server Configuration
PORT=3000
# 관리자 대시보드/HTTP API 인증 비밀번호 (대시보드 로그인에 사용)
# 대시보드 접속: http://<JUHEE_URL 호스트>:<PORT>/  (샤드 #0에서만 구동)
REQUEST_PASSWORD=change_this_to_a_strong_password

# 기타 설정
DEV_MODE=false
DEV_SERVER_ID=your_dev_server_id_here
SUPERTONIC_TOTAL_STEP=4

# 샤딩: 총 샤드 수 (기본 1). 서버 2,500개 미만이면 1 권장. 대규모는 숫자 또는 'auto'
TOTAL_SHARDS=1

# 샤드 프로세스 V8 힙 상한(MB, 기본 384). ONNX/오디오를 실제로 처리하는 자식 샤드
#  프로세스에 적용된다(매니저의 --max-old-space-size는 샤드에 미적용). 서버 RAM에 맞춰 조정.
SHARD_MAX_OLD_SPACE_MB=384

# 샤드 메모리 워치독 임계치(MB, 기본 700). 샤드 RSS가 이 값을 넘으면 음성 연결을 정리하고
#  프로세스를 종료 → ShardingManager가 자동 재기동한다(PM2가 감시하지 못하는 샤드용 안전장치).
#  힙 상한 + 네이티브(ONNX) 메모리를 함께 고려해 SHARD_MAX_OLD_SPACE_MB보다 넉넉히 크게 설정.
SHARD_MEMORY_LIMIT_MB=700

# ONNX(Supertonic) 추론 스레드 수 (기본 1). 메모리/CPU 절약을 위해 1 권장
SUPERTONIC_ORT_THREADS=1

# TTS 캐시 관리
# TTS_CACHE_MAX_MB: 캐시 폴더 총 용량 상한(MB, 기본 500). 초과 시 오래된 것부터 삭제. 0=무제한
TTS_CACHE_MAX_MB=500
# TTS_CACHE_MAX_AGE_DAYS: 캐시 보관 일수 (기본 30). 0=만료 없음
TTS_CACHE_MAX_AGE_DAYS=30